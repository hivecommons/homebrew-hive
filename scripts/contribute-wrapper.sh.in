      #!/usr/bin/env bash
      set -euo pipefail

      WRAPPER_VERSION="@VERSION@"
      CHANNEL="@CHANNEL@"
      IMAGE_REF="@IMAGE_REF@"
      IMAGE_DIGEST="@DIGEST@"
      SIF_PATH="#{libexec}/@SIF@"
      # Interactive Apptainer attaches to the tmux session the contributor
      # image creates inside the instance; the name is the image-side contract.
      TMUX_SESSION="contributor"
      TMUX_WAIT_SECONDS=60

      usage() {
        cat <<USAGE
      @BINARY@ - run the Hive contributor relay (@CAVEAT_CHANNEL@ channel)

      Usage: @BINARY@ [--wrapper-version] [--wrapper-print-runtime] [--wrapper-dry-run] [--help] [relay args...]

      --wrapper-print-runtime prints the runtime the wrapper would select.
      --wrapper-dry-run prints the resolved plan (runtime, mode, instance name,
        tmux session, image, binds) without starting anything.

      Runtime selection:
        Linux:  apptainer (default), or docker/podman when HIVE_CONTRIBUTE_RUNTIME is set.
        macOS: docker, podman, or HIVE_CONTRIBUTE_RUNTIME=lima with a Lima apptainer VM.
        The Lima path forwards the same environment and mounts as native apptainer;
        interactive Apptainer starts an instance and attaches to its tmux pane.
        Set CONTRIBUTOR_MODE=headless for non-TTY use.
        The host home must be shared into the VM at the same path AND writable
        (create the VM with --mount-writable; Lima's default home share is read-only).

      Required for real relay use: HIVE_REGISTRATION_TOKEN. Optional: HIVE_HUB,
      AGENT_BACKEND, AGENT_MODEL, AGENT_REASONING_EFFORT, CONTRIBUTOR_MODE,
      HIVE_WORKSPACE_DIR, GH_TOKEN, backend provider API keys, and CLI credential dirs.

      ~/.ssh and ~/.config/gh are NOT mounted by default. Git inside the container
      uses HTTPS with the forwarded GH_TOKEN (or GITHUB_TOKEN); without one,
      authenticated clones and pushes fail. Opt in with HIVE_CONTRIBUTE_MOUNT_SSH=1
      (read-only ~/.ssh) and/or HIVE_CONTRIBUTE_MOUNT_GH=1 (~/.config/gh).

      The workspace (HIVE_WORKSPACE_DIR, default: the current directory) is bound
      read-write. The wrapper refuses a workspace that is or contains your home
      directory; set HIVE_CONTRIBUTE_ALLOW_HOME_WORKSPACE=1 to override.
      USAGE
      }

      case "${1:-}" in
        --wrapper-version)
          echo "@BINARY@ $WRAPPER_VERSION channel=$CHANNEL image=$IMAGE_REF"
          exit 0
          ;;
        --help|-h)
          usage
          exit 0
          ;;
      esac

      host_os=$(uname -s | tr '[:upper:]' '[:lower:]')
      requested_runtime="${HIVE_CONTRIBUTE_RUNTIME:-auto}"
      workspace="${HIVE_WORKSPACE_DIR:-$PWD}"
      config_dir="${HIVE_CONTRIBUTOR_CONFIG_DIR:-$HOME/.config/hive}"
      state_dir="${HIVE_CONTRIBUTE_STATE_DIR:-$HOME/.local/state/hive/contribute}"
      container_workspace="/home/dev/workspace"
      container_config="/home/dev/.config/hive"
      container_codex="/home/dev/.codex"
      codex_home="${CODEX_HOME:-$HOME/.codex}"
      case "$workspace" in /*) ;; *) workspace="$PWD/$workspace" ;; esac

      # The workspace is bound read-write. Binding $HOME itself, an ancestor
      # of it, or / would hand the container every credential directory the
      # wrapper deliberately leaves unmounted (~/.ssh, ~/.config/gh, ~/.aws, …),
      # so refuse unless the caller opts in explicitly. Both sides are
      # canonicalised first so '.', '..', '//' and symlink spellings of $HOME
      # cannot slip past a lexical comparison; the directories exist by now.
      canonical_dir() {
        local resolved
        resolved=$(cd -P -- "$1" 2>/dev/null && pwd -P) || resolved="$1"
        # POSIX leaves a leading "//" implementation-defined and bash keeps it.
        while [[ "$resolved" == //* ]]; do resolved="${resolved#/}"; done
        printf '%s' "${resolved%/}"
      }
      workspace_exposes_home() {
        local ws home
        ws=$(canonical_dir "$1")
        home=$(canonical_dir "$HOME")
        [[ -z "$ws" || "$ws" == "$home" || "$home/" == "$ws/"* ]]
      }

      export HIVE_WORKSPACE_DIR="$container_workspace"
      export HIVE_CONTRIBUTOR_CONFIG_DIR="$container_config"
      # CODEX_HOME is forwarded through the CODEX_* allow-list, but its host
      # directory is bound at $container_codex, so point it there like the
      # workspace and config paths above; unset stays unset.
      if [[ -n "${CODEX_HOME:-}" ]]; then
        export CODEX_HOME="$container_codex"
      fi
      if [[ -z "${GH_TOKEN:-}" && -n "${GITHUB_TOKEN:-}" ]]; then
        export GH_TOKEN="$GITHUB_TOKEN"
      fi

      env_name_allowed() {
        case "$1" in
          HIVE_*|AGENT_*|CONTRIBUTOR_MODE|GH_TOKEN|GITHUB_TOKEN|GITHUB_REPOSITORY|GITHUB_ACTOR|GIT_AUTHOR_*|GIT_COMMITTER_*)
            return 0 ;;
          ANTHROPIC_*|CLAUDE_*|OPENAI_*|CODEX_*|COPILOT_*|BOBSHELL_*|GOOSE_*|META_API_KEY|MUSE_*)
            return 0 ;;
          OMP_*|PI_*|KILO_*|GEMINI_*|GOOGLE_*|ANTIGRAVITY_*|AWS_*|AZURE_*|OLLAMA_*|LITELLM_*|XAI_*|GROQ_*)
            return 0 ;;
          *) return 1 ;;
        esac
      }

      # Git inside the container authenticates over HTTPS with GH_TOKEN. The helper
      # is always configured and reads GH_TOKEN (or GITHUB_TOKEN) from the
      # container environment at use time, so no secret is in argv and a token
      # provided later (e.g. by the relay) is picked up; with no token it prints
      # nothing and git falls through to its normal behaviour.
      git_https_env() {
        printf '%s=%s\n' \
          GIT_CONFIG_COUNT 1 \
          GIT_CONFIG_KEY_0 'credential.https://github.com.helper' \
          GIT_CONFIG_VALUE_0 '!f() { t="${GH_TOKEN:-${GITHUB_TOKEN:-}}"; [ -n "$t" ] || exit 0; echo username=x-access-token; echo "password=$t"; }; f'
      }

      warn_if_no_git_auth() {
        [[ -z "${GH_TOKEN:-}" ]] || return 0
        [[ "${HIVE_CONTRIBUTE_MOUNT_SSH:-}" != 1 && "${HIVE_CONTRIBUTE_MOUNT_GH:-}" != 1 ]] || return 0
        echo "@BINARY@: GH_TOKEN/GITHUB_TOKEN is not set; git inside the container has no GitHub credentials (~/.ssh and ~/.config/gh are not mounted by default). Set GH_TOKEN, or opt in with HIVE_CONTRIBUTE_MOUNT_SSH=1 / HIVE_CONTRIBUTE_MOUNT_GH=1." >&2
      }

      collect_env_names() {
        local name
        while IFS= read -r name; do
          env_name_allowed "$name" && printf '%s\n' "$name"
        done < <(compgen -e) | sort -u
      }

      add_existing_bind() {
        local src="$1" dst="$2" mode="${3:-rw}"
        [[ -e "$src" ]] || return 0
        case "$mode" in
          ro) printf '%s:%s:ro\n' "$src" "$dst" ;;
          *) printf '%s:%s\n' "$src" "$dst" ;;
        esac
      }

      # Hand values over through APPTAINERENV_* (honoured under --containall)
      # rather than `--env NAME=VALUE`, which would expose every forwarded
      # token in the apptainer process's argv (/proc/<pid>/cmdline).
      export_apptainer_env() {
        while IFS= read -r name; do
          export "APPTAINERENV_${name}=${!name}"
        done < <(collect_env_names)
        export APPTAINERENV_HIVE_CONTAINER_RUNTIME=apptainer
        export APPTAINERENV_HIVE_CONTAINER_NAME="${HIVE_CONTAINER_NAME:-hive-contributor}"
        while IFS='=' read -r name value; do
          export "APPTAINERENV_${name}=${value}"
        done < <(git_https_env)
      }

      # Run arguments shared by the native and Lima apptainer paths.
      apptainer_args=()
      build_apptainer_args() {
        apptainer_args=(run --containall --writable-tmpfs --pwd /home/dev)
        apptainer_args+=(--bind "$workspace:$container_workspace")
        apptainer_args+=(--bind "$config_dir:$container_config")
        apptainer_args+=(--bind "$state_dir/home:/home/dev/.local/state/hive")
        apptainer_args+=(--bind "$state_dir/metrics:/var/run/hive-metrics")
        while IFS= read -r bind; do apptainer_args+=(--bind "$bind"); done < <(
          add_existing_bind "$HOME/.claude" "/home/dev/.claude"
          add_existing_bind "$HOME/.claude.json" "/home/dev/.claude.json"
          add_existing_bind "$HOME/.copilot" "/home/dev/.copilot"
          add_existing_bind "$codex_home" "$container_codex"
          add_existing_bind "$HOME/.config/goose" "/home/dev/.config/goose"
          add_existing_bind "$HOME/.config/muse" "/home/dev/.config/muse"
          add_existing_bind "$HOME/.bob" "/home/dev/.bob"
          add_existing_bind "$HOME/.gitconfig" "/home/dev/.gitconfig" ro
          if [[ "${HIVE_CONTRIBUTE_MOUNT_GH:-}" == 1 ]]; then
            add_existing_bind "$HOME/.config/gh" "/home/dev/.config/gh"
          fi
          if [[ "${HIVE_CONTRIBUTE_MOUNT_SSH:-}" == 1 ]]; then
            add_existing_bind "$HOME/.ssh" "/home/dev/.ssh" ro
          fi
        )
      }

      # OCI-derived SIFs have a runscript, not a service startscript. Start an
      # idle instance, then run the relay inside it so exec can reach its tmux.
      # The shell owns the instance and traps; Lima runs this same function in
      # the guest. Keep a supervising shell alive to stop the instance on exit.
      apptainer_interactive() {
        local image="$1" name="$APPTAINERENV_HIVE_CONTAINER_NAME"
        local relay_pid="" attach_pid="" attempt status
        shift
        if [[ ! -t 0 || ! -t 1 ]]; then
          echo "@BINARY@: interactive Apptainer needs a terminal; set CONTRIBUTOR_MODE=headless for non-TTY use." >&2
          exit 2
        fi
        apptainer instance start "${apptainer_args[@]:1}" "$image" "$name" || exit $?
        # Only install cleanup after start succeeds: a name collision must
        # never stop another invocation's instance.
        cleanup_instance() {
          [[ -z "$attach_pid" ]] || kill "$attach_pid" 2>/dev/null || true
          apptainer instance stop "$name" || true
          if [[ -n "$relay_pid" ]]; then
            kill "$relay_pid" 2>/dev/null || true
            wait "$relay_pid" 2>/dev/null || true
          fi
          [[ -z "$attach_pid" ]] || wait "$attach_pid" 2>/dev/null || true
        }
        trap cleanup_instance EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        trap 'exit 129' HUP
        apptainer run "instance://$name" "$@" &
        relay_pid=$!
        # instance start returns before the relay creates its detached pane.
        for ((attempt = 0; attempt < TMUX_WAIT_SECONDS; attempt++)); do
          if apptainer exec "instance://$name" tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
            # Preserve the terminal stdin for the background child; waiting on
            # its PID lets signal traps run promptly while the pane is attached.
            apptainer exec "instance://$name" tmux attach -t "$TMUX_SESSION" <&0 &
            attach_pid=$!
            status=0
            wait "$attach_pid" || status=$?
            exit "$status"
          fi
          if ! kill -0 "$relay_pid" 2>/dev/null; then
            status=0
            wait "$relay_pid" || status=$?
            echo "@BINARY@: relay exited before its tmux session was ready." >&2
            [[ "$status" != 0 ]] || status=1
            exit "$status"
          fi
          sleep 1
        done
        echo "@BINARY@: timed out waiting for the $TMUX_SESSION tmux session." >&2
        exit 1
      }

      apptainer_run() {
        command -v apptainer >/dev/null 2>&1 || { echo "apptainer is required on Linux; install it with Homebrew on Linux or your distro package manager." >&2; exit 127; }
        export_apptainer_env
        build_apptainer_args
        if [[ "${CONTRIBUTOR_MODE:-interactive}" == headless ]]; then
          exec apptainer "${apptainer_args[@]}" "$SIF_PATH" "$@"
        fi
        apptainer_interactive "$SIF_PATH" "$@"
        exit $?
      }

      gvisor_engine() {
        if command -v docker >/dev/null 2>&1; then echo docker; return 0; fi
        if command -v podman >/dev/null 2>&1; then echo podman; return 0; fi
        return 1
      }

      docker_like_run() {
        local engine="$1"
        shift
        local -a args=(run --rm -i --name "${HIVE_CONTAINER_NAME:-hive-contributor}")
        [[ -t 0 && -t 1 ]] && args+=(-t)
        if [[ "${HIVE_CONTRIBUTE_RUNTIME:-}" == "gvisor" ]]; then
          args+=(--runtime=runsc)
        fi
        while IFS= read -r name; do args+=(-e "$name"); done < <(collect_env_names)
        args+=(-e "HIVE_CONTAINER_RUNTIME=$engine")
        while IFS= read -r kv; do args+=(-e "$kv"); done < <(git_https_env)
        args+=(-v "$workspace:$container_workspace")
        args+=(-v "$config_dir:$container_config")
        args+=(-v "$state_dir/home:/home/dev/.local/state/hive")
        args+=(-v "$state_dir/metrics:/var/run/hive-metrics")
        [[ -e "$HOME/.claude" ]] && args+=(-v "$HOME/.claude:/home/dev/.claude")
        [[ -e "$HOME/.claude.json" ]] && args+=(-v "$HOME/.claude.json:/home/dev/.claude.json")
        [[ -e "$HOME/.copilot" ]] && args+=(-v "$HOME/.copilot:/home/dev/.copilot")
        [[ -e "$codex_home" ]] && args+=(-v "$codex_home:$container_codex")
        [[ -e "$HOME/.config/goose" ]] && args+=(-v "$HOME/.config/goose:/home/dev/.config/goose")
        [[ -e "$HOME/.config/muse" ]] && args+=(-v "$HOME/.config/muse:/home/dev/.config/muse")
        [[ -e "$HOME/.bob" ]] && args+=(-v "$HOME/.bob:/home/dev/.bob")
        [[ -e "$HOME/.gitconfig" ]] && args+=(-v "$HOME/.gitconfig:/home/dev/.gitconfig:ro")
        if [[ "${HIVE_CONTRIBUTE_MOUNT_GH:-}" == 1 && -e "$HOME/.config/gh" ]]; then
          args+=(-v "$HOME/.config/gh:/home/dev/.config/gh")
        fi
        if [[ "${HIVE_CONTRIBUTE_MOUNT_SSH:-}" == 1 && -e "$HOME/.ssh" ]]; then
          args+=(-v "$HOME/.ssh:/home/dev/.ssh:ro")
        fi
        exec "$engine" "${args[@]}" "$IMAGE_REF" "$@"
      }

      lima_run() {
        command -v limactl >/dev/null 2>&1 || { echo "limactl not found. Install Lima and create an apptainer VM." >&2; exit 127; }
        limactl list apptainer >/dev/null 2>&1 || { echo "Create a Lima Apptainer VM first: limactl create --name=apptainer --mount-writable template://apptainer && limactl start apptainer" >&2; exit 1; }
        export_apptainer_env
        build_apptainer_args
        # The VM must share the host home at the same path, writable, so the
        # bind sources above resolve inside the VM and the relay can write to
        # them. `limactl shell` does not carry the environment across, and
        # values must stay out of argv, so hand them over in a 0600 file under
        # the state dir that the VM shell sources. The host removes the file
        # when limactl exits (the guest cannot on a read-only home share, and
        # would never get the chance if limactl fails), so no exec here.
        local status=0
        lima_env_file=$(umask 077 && mktemp "$state_dir/lima-env.XXXXXX")
        trap 'rm -f "$lima_env_file"' EXIT
        while IFS= read -r name; do
          printf 'export %s=%q\n' "$name" "${!name}"
        done < <(compgen -e APPTAINERENV_) >"$lima_env_file"
        if [[ "${CONTRIBUTOR_MODE:-interactive}" == headless ]]; then
          limactl shell apptainer bash -c '. "$1"; shift; exec apptainer "$@"' _ "$lima_env_file" "${apptainer_args[@]}" "docker://$IMAGE_REF" "$@" || status=$?
        else
          # Transfer the shared lifecycle code and bind array along with the
          # environment; secrets remain in the private file, never in argv.
          declare -p apptainer_args TMUX_SESSION TMUX_WAIT_SECONDS >>"$lima_env_file"
          declare -f apptainer_interactive >>"$lima_env_file"
          limactl shell apptainer bash -c '. "$1"; shift; apptainer_interactive "$@"' _ "$lima_env_file" "docker://$IMAGE_REF" "$@" || status=$?
        fi
        rm -f "$lima_env_file"
        exit "$status"
      }

      case "$requested_runtime" in
        auto|apptainer|docker|podman|gvisor|lima) ;;
        *) echo "unknown HIVE_CONTRIBUTE_RUNTIME=$requested_runtime" >&2; exit 2 ;;
      esac

      # Prints the runtime the run path below would select, or "none" (status 1).
      resolve_runtime() {
        if [[ "$host_os" == linux* && "$requested_runtime" == auto ]]; then echo apptainer; return 0; fi
        if [[ "$requested_runtime" == gvisor ]]; then
          gvisor_engine && return 0
          echo none
          return 1
        fi
        if [[ "$requested_runtime" == auto ]]; then
          for runtime in docker podman lima; do
            if [[ "$runtime" == lima ]] && command -v limactl >/dev/null 2>&1; then echo lima; return 0; fi
            if command -v "$runtime" >/dev/null 2>&1; then echo "$runtime"; return 0; fi
          done
        else
          if [[ "$requested_runtime" == lima ]]; then
            if command -v limactl >/dev/null 2>&1; then echo lima; return 0; fi
          else
            if command -v "$requested_runtime" >/dev/null 2>&1; then echo "$requested_runtime"; return 0; fi
          fi
        fi
        echo none
        return 1
      }

      if [[ "${1:-}" == "--wrapper-print-runtime" ]]; then
        resolve_runtime
        exit $?
      fi

      refuse_home_workspace() {
        if workspace_exposes_home "$workspace" && [[ "${HIVE_CONTRIBUTE_ALLOW_HOME_WORKSPACE:-}" != 1 ]]; then
          echo "@BINARY@: refusing to use $workspace as the workspace: it contains your home directory, so binding it would mount ~/.ssh, ~/.config/gh and every other credential directory into the container. Run from a project directory or set HIVE_WORKSPACE_DIR; set HIVE_CONTRIBUTE_ALLOW_HOME_WORKSPACE=1 to override." >&2
          exit 2
        fi
      }

      # Resolve exactly what the run path would do, without creating
      # directories, forwarding secrets or invoking any engine. This is what
      # the formula's `brew test` checks, since CI has no instance to start.
      if [[ "${1:-}" == "--wrapper-dry-run" ]]; then
        refuse_home_workspace
        available=yes
        if [[ "$requested_runtime" == auto ]]; then
          runtime=$(resolve_runtime) || available=no
        else
          runtime="$requested_runtime"
          resolve_runtime >/dev/null 2>&1 || available=no
        fi
        # resolve_runtime does not probe Linux auto, yet the run path exits 127
        # without apptainer, so check the resolved engine is really installed.
        case "$runtime" in
          apptainer) command -v apptainer >/dev/null 2>&1 || available=no ;;
          lima) command -v limactl >/dev/null 2>&1 || available=no ;;
          docker|podman) command -v "$runtime" >/dev/null 2>&1 || available=no ;;
          gvisor) gvisor_engine >/dev/null 2>&1 || available=no ;;
        esac
        mode=interactive
        [[ "${CONTRIBUTOR_MODE:-interactive}" != headless ]] || mode=headless
        case "$runtime" in
          apptainer) image="$SIF_PATH" ;;
          lima) image="docker://$IMAGE_REF" ;;
          *) image="$IMAGE_REF" ;;
        esac
        lifecycle=run
        case "$runtime" in
          apptainer|lima) [[ "$mode" == headless ]] || lifecycle=instance ;;
        esac
        printf '%s=%s\n' \
          runtime "$runtime" \
          runtime_available "$available" \
          mode "$mode" \
          lifecycle "$lifecycle" \
          container_name "${HIVE_CONTAINER_NAME:-hive-contributor}" \
          tmux_session "$TMUX_SESSION" \
          tmux_wait_seconds "$TMUX_WAIT_SECONDS" \
          image "$image" \
          workspace "$workspace" \
          config_dir "$config_dir" \
          state_dir "$state_dir"
        case "$runtime" in
          apptainer|lima)
            build_apptainer_args
            for ((i = 0; i < ${#apptainer_args[@]}; i++)); do
              [[ "${apptainer_args[i]}" == --bind ]] && printf 'bind=%s\n' "${apptainer_args[i + 1]}"
            done
            ;;
        esac
        exit 0
      fi

      mkdir -p "$workspace" "$config_dir" "$state_dir/home" "$state_dir/metrics"

      refuse_home_workspace
      warn_if_no_git_auth

      case "$requested_runtime" in
        auto)
          if [[ "$host_os" == linux* ]]; then apptainer_run "$@"; fi
          if command -v docker >/dev/null 2>&1; then docker_like_run docker "$@"; fi
          if command -v podman >/dev/null 2>&1; then docker_like_run podman "$@"; fi
          lima_run "$@"
          ;;
        apptainer) apptainer_run "$@" ;;
        docker) docker_like_run docker "$@" ;;
        gvisor)
          engine=$(gvisor_engine) || { echo "HIVE_CONTRIBUTE_RUNTIME=gvisor needs docker or podman with runsc configured" >&2; exit 127; }
          docker_like_run "$engine" "$@"
          ;;
        podman) docker_like_run podman "$@" ;;
        lima) lima_run "$@" ;;
        # Unreachable: the accepted set is validated once above, before --wrapper-print-runtime.
        *) echo "@BINARY@: internal error: unhandled runtime $requested_runtime" >&2; exit 70 ;;
      esac
